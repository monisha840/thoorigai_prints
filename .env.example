# Absolute origin of the deployed site. Used for canonical URLs, OpenGraph,
# the sitemap and JSON-LD. No trailing slash.
#
# This value decides which host is canonical. It must stay in agreement with
# CANONICAL_HOST in next.config.ts, which redirects the bare apex to www — if
# the two disagree, the site advertises one host and serves another.
#
# robots.ts also reads it: any origin other than the production host serves
# `Disallow: /`, so preview and staging deployments cannot be indexed.
NEXT_PUBLIC_SITE_URL=https://www.thoorigaiprints.com

# Set automatically by Vercel. Anything other than "production" forces the
# staging robots.txt regardless of the URL above. Left here for documentation;
# do not set it by hand.
# VERCEL_ENV=production

# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files. `.env.example` is tracked deliberately — it is the only record
# of what a deployment needs, and `vercel link` writes a real OIDC token into
# `.env.local`, so the negation has to be explicit rather than assumed.
.env
.env*.local
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo

# scratch / scraping workspace (not part of the app)
/_work/

# Raw capture of the legacy WordPress site. 6.8MB of somebody else's markup,
# kept locally as the evidence behind docs/content-audit.md and the redirect
# map — it is a research artefact, not source, and nothing in src/ reads it.
/_raw/

# Theme-demo assets from the template the legacy site was built on. Unused,
# unlicensed for this business, and must never reach a build.
/assets/_theme-demo-unused/
